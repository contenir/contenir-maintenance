{
    "name": "contenir/maintenance",
    "description": "Framework-agnostic maintenance-mode toggle for Contenir CMS — admin writes, Site reads.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": { "Contenir\\Maintenance\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Contenir\\Maintenance\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}